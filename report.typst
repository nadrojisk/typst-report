// ============================================================
// report.typst — Report Typst template
// Pandoc template for: -t typst --template=report.typst
//
//   • Pansy palette (the daystrom / Forgejo theme): purple 285 / green 145
//   • Full-bleed cover with a vector snowflake motif — no image assets
//   • Running header (title + snowflake mark), footer (section + page)
//   • Roman-numeral front matter, arabic body, lettered appendices
//   • Tables, listings, figures, cross-references via filters/
// ============================================================

// ---- pandoc preamble -------------------------------------------------------
#set terms(hanging-indent: 1.5em)
#set smartquote(enabled: $if(smart)$true$else$false$endif$)

// Rule width cascade — most specific wins:
//   table-rule-width  (table rules only)
//   page-rule-width   (thematic-break `---` rule only)
//   rule-width        (shared fallback for both, if neither of the above is set)
//   1.25pt            (final built-in default)
#let report-rule-width = $if(table-rule-width)$$table-rule-width$$elseif(rule-width)$$rule-width$$else$1.25pt$endif$
#let report-page-rule-width = $if(page-rule-width)$$page-rule-width$$elseif(rule-width)$$rule-width$$else$1.25pt$endif$

// Tables: no cell borders (booktabs style — the filter adds rules), left
// aligned, roomy padding, rows may break across pages.
#set table(
  stroke: none,
  align: left,
  inset: (x: 6pt, y: 9pt),
)
#set table.cell(breakable: true)

#show figure.where(kind: table): set block(breakable: true)
#show figure.where(kind: table): set figure(placement: none, gap: 1.2em)
#show figure.where(kind: table): set block(above: 2.8em, below: 1.8em)
#show figure.where(kind: table): set figure.caption(
  position: $if(table-caption-position)$$table-caption-position$$else$top$endif$
)
// a table's caption must never be stranded at the foot of a page away from the table
#show figure.caption.where(kind: table): set block(sticky: true)
#show figure.where(kind: image): set block(above: 1.8em, below: 2.2em)
#show figure.where(kind: image): set figure.caption(
  position: $if(figure-caption-position)$$figure-caption-position$$else$bottom$endif$
)

// Listing figures (code blocks with captions)
#show figure.where(kind: "listing"): set figure(placement: none, supplement: "Listing")
#show figure.where(kind: "listing"): set figure.caption(position: bottom)
#show figure.where(kind: "listing"): set block(above: 1.8em, below: 1.8em)

$if(highlighting-definitions)$
// syntax highlighting functions from skylighting:
$highlighting-definitions$

$endif$
// ---- Color palette: Pansy ---------------------------------------------------
// Base ramps are OKLCH, generated by relative-chroma matching: chroma is a
// fixed fraction of each hue's own sRGB gamut ceiling, so purple (285), green
// (145) and red (25) read as one family. Lightness steps are shared across
// ramps (50 ... 950), with 500 at L 0.515. Semantic roles below point into the
// ramps; everything else in this file uses the roles or the aliases after them.
#let ramp(hue, chromas) = (
  "50": 97%, "100": 93%, "200": 87%, "300": 79%, "400": 65%,
  "500": 51.5%, "600": 43%, "700": 36%, "800": 29%, "900": 23%, "950": 16%,
).pairs().map(((step, l)) => (step, oklch(l, chromas.at(step), hue))).to-dict()

#let purple = ramp(285deg, (
  "50": 0.02, "100": 0.04, "200": 0.07, "300": 0.11, "400": 0.16, "500": 0.20,
  "600": 0.20, "700": 0.18, "800": 0.15, "900": 0.12, "950": 0.08))
#let green = ramp(145deg, (
  "50": 0.070, "100": 0.148, "200": 0.286, "300": 0.247, "400": 0.167, "500": 0.114,
  "600": 0.108, "700": 0.097, "800": 0.081, "900": 0.065, "950": 0.043))
// neutral: same lightness curve, low chroma, tinted toward the purple hue
#let neutral = ramp(285deg, (
  "50": 0.010, "100": 0.014, "200": 0.018, "300": 0.020, "400": 0.022, "500": 0.022,
  "600": 0.020, "700": 0.018, "800": 0.015, "900": 0.012, "950": 0.008))
// error: base only (500); the full ramp is not built yet
#let red-500 = oklch(51.5%, 0.146, 25deg)
// warning orange: hue 55 at the same 70% chroma share, but lightness 0.62. At the
// ramps' 0.515 an orange only reaches brown, and reads as a dull red next to red-500.
#let orange-500 = oklch(62%, 0.108, 55deg)

// ---- semantic roles (light) ----
#let color-primary           = purple.at("500")
#let color-primary-variant   = purple.at("700")
#let color-secondary         = green.at("500")
#let color-secondary-variant = green.at("700")
#let color-error             = red-500
#let color-background        = neutral.at("50")
#let color-surface           = oklch(99.5%, 0.004, 285deg)
#let color-outline           = neutral.at("200")
#let color-text              = neutral.at("950")
#let color-text-muted        = neutral.at("600")
// ---- semantic roles (dark): used on the dark covers ----
#let color-primary-dark-scheme   = oklch(65%, 0.17, 285deg)
#let color-secondary-dark-scheme = oklch(65%, 0.10, 145deg)
#let color-error-dark-scheme     = oklch(65%, 0.13, 25deg)

// ---- aliases used throughout this file and by the filters ----
#let report-primary        = color-primary
#let report-primary-dark   = purple.at("600")
#let report-primary-deep   = purple.at("800")
#let report-primary-light  = purple.at("400")
#let report-primary-bright = color-primary-dark-scheme   // the favicon's purple on dark
#let report-primary-mist   = purple.at("200")
#let report-nav            = purple.at("800")
#let report-night          = purple.at("900")
#let report-midnight       = purple.at("950")
#let report-green          = color-secondary
#let report-green-bright   = color-secondary-dark-scheme
#let report-red            = color-error
#let report-text           = color-text
#let report-text-light     = neutral.at("700")
#let report-muted          = color-text-muted
#let report-surface        = color-background
#let report-background     = color-background
#let report-border         = color-outline
#let link-color-default    = report-primary

// Names usable in front matter (primary-color: ..., header-color=..., ...) —
// the aliases above, plus every ramp step as `purple-500`, `green-200`, ...
#let report-named-colors = (
  "primary":       report-primary,
  "primary-dark":  report-primary-dark,
  "primary-light": report-primary-light,
  "primary-mist":  report-primary-mist,
  "nav":           report-nav,
  "night":         report-night,
  "green":         report-green,
  "red":           report-red,
  "text":          report-text,
  "muted":         report-muted,
  "surface":       report-surface,
  "ltgray":        report-surface,
  "border":        report-border,
  "white": white,  "black": black,
)
#let report-named-colors = {
  let d = report-named-colors
  for (name, r) in (purple: purple, green: green, neutral: neutral) {
    for (step, c) in r { d.insert(name + "-" + step, c) }
  }
  d.insert("red-500", red-500)
  d.insert("orange-500", orange-500)
  d
}

// table.hline() default stroke. Tables override this via the filter.
#set table.hline(stroke: report-rule-width + report-border)

// ---- theme states -----------------------------------------------------------
// Published by conf() so raw Typst emitted by Lua filters into the document
// body can read the colors the document actually resolved at render time,
// instead of a value baked in at pandoc-filter time.
#let theme-primary = state("theme-primary", report-primary)
#let theme-table-rule = state("theme-table-rule", report-primary)
#let theme-page-rule  = state("theme-page-rule", report-primary)

// Thematic break (markdown `---`). Pandoc's Typst writer emits a bare
// lowercase `#horizontalrule`, so this must use exactly that name.
#let horizontalrule = context line(
  start: (25%, 0%), end: (75%, 0%),
  stroke: report-page-rule-width + theme-page-rule.get(),
)

#let resolve-color(name, fallback) = {
  if name == none { return fallback }
  let s = str(name)
  if s == "primarycolor" { return theme-primary.get() }
  if s in report-named-colors { return report-named-colors.at(s) }
  if s.starts-with("#") { return rgb(s) }
  if s.len() == 6        { return rgb("#" + s) }
  fallback
}

// Footer section name; global so filters (appendix) can update it too.
#let current-section = state("current-section", "")

// Flatten content to a plain string (for the running footer).
#let plain-text(c) = {
  if type(c) == str { c }
  else if c == [] { "" }
  else if c.has("text") { c.text }
  else if c.has("child") { plain-text(c.child) }
  else if c.has("body") { plain-text(c.body) }
  else if c.has("children") { c.children.map(plain-text).join() }
  else if c == [ ] { " " }
  else { "" }
}

// ---- callouts ---------------------------------------------------------------
// Emitted by filters/typst-callouts.lua for `> [!NOTE]` alerts and `::: {.note}` divs.
#let callout-colors = (
  note: neutral.at("500"),
  tip: color-secondary,
  important: color-primary,
  warning: orange-500,
  caution: color-error,
)
// A small vector glyph per kind, so the type reads without color (greyscale prints):
//   note: circle "i"   tip: circle check   important: diamond "!"
//   warning: triangle "!"   caution: hexagon "x"
#let callout-icon(kind, c) = {
  let s = 12pt
  let mark(ch, dy: 0pt) = place(center + horizon, dy: dy,
    text(size: 8pt, weight: "bold", fill: white, top-edge: "bounds", bottom-edge: "bounds", ch))
  box(width: s, height: s, baseline: 2.2pt, {
    if kind == "note" {
      place(center + horizon, circle(radius: s / 2, fill: c))
      mark("i")
    } else if kind == "tip" {
      place(center + horizon, circle(radius: s / 2, fill: c))
      place(top + left, dx: 3pt, dy: 6.2pt, line(end: (2pt, 2pt), stroke: (paint: white, thickness: 1.5pt, cap: "round")))
      place(top + left, dx: 5pt, dy: 8.2pt, line(end: (4pt, -5pt), stroke: (paint: white, thickness: 1.5pt, cap: "round")))
    } else if kind == "important" {
      place(top + left, polygon(fill: c, (s / 2, 0pt), (s, s / 2), (s / 2, s), (0pt, s / 2)))
      mark("!")
    } else if kind == "warning" {
      place(top + left, polygon(fill: c, stroke: (paint: c, thickness: 1pt, join: "round"), (s / 2, 0.8pt), (s - 0.5pt, s - 0.8pt), (0.5pt, s - 0.8pt)))
      mark("!", dy: 1.2pt)
    } else {
      let r = s / 2
      let pts = range(6).map(k => (r + r * calc.cos(k * 60deg + 30deg), r + r * calc.sin(k * 60deg + 30deg)))
      place(top + left, polygon(fill: c, ..pts))
      mark("×", dy: -0.2pt)
    }
  })
}

#let callout(kind, title, body) = {
  let c = callout-colors.at(kind)
  block(
    width: 100%, breakable: true, above: 1.1em, below: 1.1em, radius: 3pt,
    fill: color.mix((c, 9%), (white, 91%)),
    inset: (left: 13pt, right: 12pt, y: 9pt),
    stroke: (left: 3pt + c),
    {
      set par(justify: false, first-line-indent: 0pt)
      block(below: 0.5em, {
        callout-icon(kind, c)
        h(5pt)
        // the orange is the lightest base color; darken its label text for print legibility
        let label-c = if kind == "warning" { color.mix((c, 65%), (black, 35%)) } else { c }
        text(weight: "bold", size: 0.85em, fill: label-c, tracking: 0.04em, upper(title))
      })
      body
    },
  )
}

// Small status mark for `cell-colorize` table cells (typst-table-colors.lua), reusing the
// callout shapes so a tinted cell is still readable in greyscale: tip = match, warning =
// partial, caution = no.
#let cell-mark(kind) = box(baseline: 2.4pt, scale(75%, reflow: true, callout-icon(kind, callout-colors.at(kind))))

// ---- snowflake --------------------------------------------------------------
// The flake from the wiki favicon (homelab/branding, wiki assets/brand/
// favicon.svg): eight arms, each a spoke with two slanted branch pairs. The
// geometry below is that SVG's, normalised to a unit radius. `size` is the
// full diameter; `thickness` is the stroke weight (the favicon itself uses
// about 0.089 of the radius, which is very bold; covers use a lighter weight).
#let snowflake-arm = (
  (0.0, 0.0, 1.0, 0.0),                        // spoke
  (0.5013, 0.0, 0.6016,  0.1504),              // inner branch pair
  (0.5013, 0.0, 0.6016, -0.1504),
  (0.7013, 0.0, 0.9018,  0.3008),              // outer branch pair
  (0.7013, 0.0, 0.9018, -0.3008),
)

#let snowflake(size, paint, thickness: 1pt, rotation: 0deg) = {
  let r = size / 2
  box(width: size, height: size, {
    for k in range(8) {
      let a = rotation + k * 45deg
      let ca = calc.cos(a)
      let sa = calc.sin(a)
      for (x0, y0, x1, y1) in snowflake-arm {
        let px0 = r + (x0 * ca - y0 * sa) * r
        let py0 = r - (x0 * sa + y0 * ca) * r
        let px1 = r + (x1 * ca - y1 * sa) * r
        let py1 = r - (x1 * sa + y1 * ca) * r
        place(top + left, dx: px0, dy: py0,
          line(start: (0pt, 0pt), end: (px1 - px0, py1 - py0),
            stroke: (paint: paint, thickness: thickness, cap: "round")))
      }
    }
  })
}

// Level-1 heading renderer, shared with typst-appendix.lua so appendix
// headings match body headings.
#let report-h1(body) = {
  set text(size: 22pt, weight: "bold", fill: report-nav)
  set par(first-line-indent: 0pt, spacing: 0pt, leading: 0.4em)
  block(above: 1.2em, below: 0.9em, {
    // block spacing (1.2em of the 22pt text) would otherwise separate the title from its rule
    set block(spacing: 0pt)
    body
    v(0.5em)
    line(length: 2.4em, stroke: 2.5pt + theme-primary.get())
  })
}

// ---- conf() ----------------------------------------------------------------
#let conf(
  title:           none,
  subtitle:        none,
  authors:         (),
  date:            none,
  version:         none,
  // front matter
  abstract:        none,
  exec-summary:    none,
  summary:         none,
  acronyms:        (),
  definitions:     (),
  acknowledgments: none,
  // page flags
  cover:           true,
  cover-style:     "flake",
  back-cover:      false,
  toc:             false,
  lof:             false,
  lot:             false,
  lol:             false,
  // colors
  primary-color:   none,
  theme-color:     none,
  rule-color:          none,
  table-rule-color:    none,
  page-rule-color:     none,
  verbatim-color:  none,
  verbatim-accent-color:      none,
  verbatim-background-color:  none,
  caption-color:   none,
  linkcolor:       none,
  // fonts
  font:            ("Inter", "DejaVu Sans"),
  monofont:        ("JetBrains Mono", "DejaVu Sans Mono"),
  fontsize:        10.5pt,
  // layout
  paper:           "us-letter",
  margin:          (top: 1.1in, bottom: 1.1in, left: 1.1in, right: 1.1in),
  cols:            1,
  no-indent:       false,
  doc,
) = {

  // ---- resolve accent colors -----------------------------------------------
  let primary = resolve-color(
    if primary-color != none { primary-color }
    else if theme-color != none { theme-color }
    else { none }, report-primary)
  theme-primary.update(primary)

  // Cascade (most specific wins): table-rule-color/page-rule-color →
  // rule-color → primary.
  let table-rule = resolve-color(
    if table-rule-color != none { table-rule-color }
    else if rule-color != none { rule-color }
    else { none }, primary)
  theme-table-rule.update(table-rule)
  let page-rule = resolve-color(
    if page-rule-color != none { page-rule-color }
    else if rule-color != none { rule-color }
    else { none }, primary)
  theme-page-rule.update(page-rule)

  let verb-color  = resolve-color(
    if verbatim-color != none { verbatim-color }
    else if theme-color != none { theme-color }
    else { none }, report-primary-dark)
  let verb-accent = resolve-color(
    if verbatim-accent-color != none { verbatim-accent-color }
    else if theme-color != none { theme-color }
    else { none }, primary)
  let verb-bg    = resolve-color(verbatim-background-color, report-surface)
  let caption-fg = resolve-color(caption-color, report-text-light)
  let link-color = resolve-color(linkcolor, primary)

  set document(
    title: if title != none { title } else { "" },
    author: authors.map(a => plain-text(a.name)),
  )

  // ---- global text & paragraph rules --------------------------------------
  set text(font: font, size: fontsize, lang: "en", fill: report-text)
  set par(
    justify: true, leading: 0.7em, spacing: 1em,
    first-line-indent: if no-indent { 0pt } else { (amount: 14pt, all: false) },
  )
  // first-line-indent's `all: false` only exempts the first paragraph of the
  // document flow; reset inside any block (notes, callouts, table cells).
  show block: set par(first-line-indent: 0pt)
  set list(
    indent: 0.5em, body-indent: 0.5em,
    marker: (text(fill: primary)[•], text(fill: primary)[–], text(fill: primary)[○]),
  )
  set enum(indent: 0.5em, body-indent: 0.5em)
  show enum.item: it => {
    show regex("^\\d+\\."): set text(fill: primary)
    it
  }
  show list: set block(below: 1.4em)
  show enum: set block(below: 1.4em)

  // Tables: left-aligned, never justified inside cells
  show table: set par(justify: false, first-line-indent: 0pt)
  show table: set text(size: 9.5pt)
  show table.cell: set par(justify: false, first-line-indent: 0pt)

  // Block quotes: accent bar, muted text
  show quote.where(block: true): it => block(
    width: 100%, inset: (left: 14pt, y: 2pt), above: 1.15em, below: 0.9em,
    stroke: (left: 2.5pt + report-primary-light),
    text(fill: report-text-light, style: "italic", it.body),
  )

  // ---- headings -----------------------------------------------------------
  show heading.where(level: 1): it => {
    // outline titles ("Figures", "Tables") are unoutlined headings: they must not rename the footer
    if it.outlined { current-section.update(plain-text(it.body)) }
    report-h1({
      if it.numbering != none {
        counter(heading).display(it.numbering)
        h(0.45em)
      }
      it.body
    })
  }
  show heading.where(level: 2): it => {
    set text(size: 15pt, weight: "bold", fill: primary)
    block(above: 1.8em, below: 1em, it)
  }
  show heading.where(level: 3): it => {
    set text(size: 12pt, weight: "bold", fill: report-primary-dark)
    block(above: 1.6em, below: 0.9em, it)
  }
  show heading.where(level: 4): it => {
    set text(size: 10.5pt, weight: "bold", fill: report-text-light)
    block(above: 1.4em, below: 0.8em, it)
  }
  show heading.where(level: 5): it => {
    set text(size: 10.5pt, weight: "bold", style: "italic", fill: report-text-light)
    block(above: 1.4em, below: 0.8em, it.body)
  }

  // ---- captions -------------------------------------------------------------
  // Centered when the whole caption fits on one line, otherwise a hanging
  // label column with a left-aligned body.
  show figure.caption: it => {
    set text(size: 9.5pt, fill: caption-fg)
    set par(justify: false, first-line-indent: 0pt)
    context {
      let lbl = text(weight: "bold", fill: report-primary-dark,
        it.supplement + [~] + it.counter.display(it.numbering) + it.separator)
      let full = lbl + it.body
      layout(size => {
        if measure(full).width <= size.width {
          align(center, full)
        } else {
          grid(
            columns: (measure(lbl).width + 6pt, 1fr),
            column-gutter: 0pt,
            align: (top + left, top + left),
            lbl, it.body,
          )
        }
      })
    }
  }

  // ---- links & code ---------------------------------------------------------
  show link: set text(fill: link-color)

  show raw: set text(font: monofont)
  show raw.where(block: false): it => box(
    fill: verb-bg, radius: 2pt, inset: (x: 3pt), outset: (y: 3pt),
    text(fill: verb-color, size: 0.92em, it),
  )
  show raw.where(block: true): it => {
    set text(size: 8.5pt)
    block(
      width: 100%, fill: verb-bg, radius: 3pt, inset: 0pt, clip: true,
      layout(size => {
        let padded = pad(left: 12pt, right: 10pt, top: 8pt, bottom: 8pt, align(left, it))
        let blk-h = measure(block(width: size.width, padded)).height
        place(top + left, rect(width: 3pt, height: blk-h, fill: verb-accent))
        padded
      })
    )
  }

  // =========================================================================
  // ---- COVER ----------------------------------------------------------------
  // =========================================================================
  // Six styles, chosen with `cover-style:` in the front matter:
  //   flake          (default) deep indigo, one heavy snowflake bleeding off low-right
  //   flake-light    the same composition, indigo on off-white
  //   lattice        deep indigo, a wallpaper of tiny flakes fading toward the title
  //   lattice-light  the same, indigo on off-white
  //   spine          white page, indigo spine with a single mark and vertical metadata
  //   band           indigo header band holding a ghosted flake, title on white below
  let render-cover() = {
    let pw = 8.5in
    let ph = 11in
    if paper != "us-letter" { pw = 210mm; ph = 297mm }
    let dark = gradient.linear(report-midnight, report-nav, angle: 155deg)
    let paper-tint = report-background
    // Colour of the dark gradient at a point (angle 155deg), so a "faded" flake is an
    // opaque blend with the background rather than a transparent stroke, whose
    // overlapping arms would double up and read brighter where they cross.
    let dark-at(x, y) = {
      let dx = calc.cos(155deg)
      let dy = calc.sin(155deg)
      let t = 0.5 + ((x - pw / 2) * dx + (y - ph / 2) * dy) / (pw * calc.abs(dx) + ph * calc.abs(dy))
      dark.sample(calc.min(100%, calc.max(0%, t * 100%)))
    }
    let fade-to(fg, bg, amount) = color.mix((fg, 100% - amount), (bg, amount))
    let at(x, y, body) = place(top + left, dx: x, dy: y, body)
    let meta-line = authors.map(a => a.name).join(", ")
    let date-line = {
      let parts = ()
      if date != none { parts.push(date) }
      if version != none { parts.push([Version #version]) }
      parts.join([ #h(0.5em)/#h(0.5em) ])
    }
    // Palette per variant: (page fill, title, subtitle, rule, meta name, meta date, flake accent)
    let light = cover-style.ends-with("-light") or cover-style == "spine" or cover-style == "band"
    let ink      = if light { report-nav } else { white }
    let ink-sub  = if light { report-text-light } else { report-primary-mist }
    let ink-rule = if light { report-green } else { report-green-bright }
    let ink-date = if light { report-muted } else { report-primary-light }

    // accent rule + title + subtitle
    let title-block(x, y, width, size: 40pt) = at(x, y, box(width: width, {
      set par(justify: false, first-line-indent: 0pt, leading: 0.5em, spacing: 0pt)
      line(length: 0.9in, stroke: 3pt + ink-rule)
      v(0.32in)
      if title != none { text(size: size, weight: "bold", fill: ink, hyphenate: false, title) }
      if subtitle != none { v(0.22in); text(size: 17pt, fill: ink-sub, subtitle) }
    }))
    let meta-block(x: 1.0in) = place(bottom + left, dx: x, dy: -1.0in, {
      set par(justify: false, first-line-indent: 0pt, leading: 0.6em, spacing: 0pt)
      if authors.len() > 0 { text(size: 12pt, fill: ink, weight: "medium", meta-line) }
      if authors.len() > 0 and date-line != [] { v(0.8em) }
      text(size: 11pt, fill: ink-date, date-line)
    })
    let cover-page(fill, body) = page(
      paper: paper, margin: 0pt, header: none, footer: none, numbering: none, fill: fill, body)

    if cover-style == "spine" {
      cover-page(white, {
        at(0pt, 0pt, rect(width: 2.3in, height: ph, fill: dark))
        at(0.7in, 1.0in, snowflake(0.42in, report-green-bright, thickness: 1.5pt))
        place(bottom + left, dx: 0.7in, dy: -1.0in,
          rotate(-90deg, origin: bottom + left, reflow: false,
            text(size: 8.5pt, fill: report-primary-light, tracking: 2pt,
              upper(meta-line + "   ·   " + date-line))))
        title-block(3.1in, 3.4in, pw - 3.1in - 1.0in, size: 38pt)
      })
    } else if cover-style == "band" {
      cover-page(white, {
        at(0pt, 0pt, rect(width: pw, height: 4.2in, fill: dark))
        at(pw - 3.7in, 0.35in,
          snowflake(3.5in, fade-to(report-primary-light, dark-at(pw - 2in, 2in), 35%), thickness: 3pt))
        at(1.0in, 1.0in, snowflake(0.42in, report-green-bright, thickness: 1.5pt))
        title-block(1.0in, 5.0in, pw - 2.0in)
        meta-block()
      })
    } else if cover-style == "lattice" or cover-style == "lattice-light" {
      cover-page(if light { paper-tint } else { dark }, {
        let gx = 0.62in
        let gy = 0.62in
        for jj in range(0, 19) {
          for ii in range(0, 14) {
            let x = ii * gx + 0.45in + (if calc.odd(jj) { gx / 2 } else { 0pt })
            let y = jj * gy * 0.88 + 0.5in
            let d = calc.sqrt(calc.pow((x - pw) / 1in, 2) + calc.pow(y / 1in, 2))
            let fade = if light { calc.min(96%, 30% + d * 7%) } else { calc.min(97%, 25% + d * 8.6%) }
            let hot = (ii == 9 and jj == 4)
            // keep the wallpaper clear of the title block
            let behind-title = x < pw - 2.2in and y > ph - 4.9in and y < ph - 2.5in
            if x < pw + 0.1in and fade < 96% and not behind-title {
              at(x - 0.14in, y - 0.14in, snowflake(0.28in,
                if hot { ink-rule }
                else if light { fade-to(report-primary, paper-tint, fade) }
                else { fade-to(report-primary-mist, dark-at(x, y), fade) },
                thickness: 0.8pt))
            }
          }
        }
        title-block(1.0in, ph - 4.5in, pw - 2.0in)
        meta-block()
      })
    } else {
      // flake / flake-light
      cover-page(if light { paper-tint } else { dark }, {
        at(pw - 5.4in, ph - 7.0in, snowflake(8.4in,
          if light { report-primary } else { report-primary-bright },
          thickness: 11pt))
        at(1.0in, 1.0in, snowflake(0.42in, ink-rule, thickness: 1.5pt))
        title-block(1.0in, 2.2in, pw - 2.6in)
        meta-block()
      })
    }
  }

  // Cover-less documents get a compact title block instead.
  let render-title-block() = {
    set par(justify: false, first-line-indent: 0pt, leading: 0.5em, spacing: 0pt)
    block(below: 2.2em, {
      line(length: 0.9in, stroke: 3pt + report-green)
      v(0.2in)
      if title != none { text(size: 30pt, weight: "bold", fill: report-nav, title) }
      if subtitle != none { v(0.12in); text(size: 15pt, fill: report-text-light, subtitle) }
      v(0.18in)
      set text(size: 10.5pt, fill: report-muted)
      let meta = ()
      if authors.len() > 0 { meta.push(authors.map(a => a.name).join(", ")) }
      if date != none { meta.push(date) }
      if version != none { meta.push([Version #version]) }
      meta.join([ #h(0.5em)·#h(0.5em) ])
    })
  }

  // =========================================================================
  // ---- PAGE STYLE (everything after the cover) --------------------------------
  // =========================================================================
  if cover { render-cover() }

  set page(
    paper: paper,
    margin: margin,
    fill: white,
    header: context {
      if here().page() > 1 or not cover {
        set text(size: 8.5pt, fill: report-muted)
        grid(
          columns: (1fr, auto), align: (left + horizon, right + horizon),
          if title != none { title } else { [] },
          snowflake(0.2in, report-primary-light, thickness: 0.7pt),
        )
      }
    },
    header-ascent: 45%,
    footer: context {
      let sect = current-section.get()
      set text(size: 8.5pt, fill: report-muted)
      line(length: 100%, stroke: 0.5pt + report-border)
      v(5pt)
      grid(
        columns: (1fr, auto), align: (left, right),
        sect,
        text(fill: primary, weight: "bold", counter(page).display()),
      )
    },
    footer-descent: 40%,
    numbering: "i",
  )
  counter(page).update(1)

  // =========================================================================
  // ---- FRONT MATTER ---------------------------------------------------------
  // =========================================================================
  let fm-section(heading-text, body) = {
    current-section.update(heading-text)
    heading(level: 1, outlined: true, numbering: none, heading-text)
    body
    pagebreak(weak: true)
  }

  let render-def-list(items, key-field, val-field) = {
    set par(justify: false)
    grid(
      columns: (auto, 1fr),
      column-gutter: 1.5em,
      row-gutter: 0.6em,
      ..items.map(item => (
        text(weight: "bold", fill: report-primary-dark, str(item.at(key-field, default: ""))),
        str(item.at(val-field, default: "")),
      )).flatten()
    )
  }

  if not cover { render-title-block() }

  if abstract != none        { fm-section("Abstract", abstract) }
  if exec-summary != none    { fm-section("Executive Summary", exec-summary) }
  if summary != none         { fm-section("Summary", summary) }
  if acronyms.len() > 0 {
    fm-section("Acronyms and Abbreviations",
      render-def-list(acronyms, "abbr", "term"))
  }
  if definitions.len() > 0 {
    fm-section("Definitions",
      render-def-list(definitions, "term", "definition"))
  }
  if acknowledgments != none { fm-section("Acknowledgments", acknowledgments) }

  // ---- outlines ---------------------------------------------------------------
  show outline.entry.where(level: 1): it => {
    v(10pt, weak: true)
    strong(it)
  }
  show outline.entry: set text(size: 10pt)
  show outline: set heading(outlined: false)

  if toc {
    current-section.update("Contents")
    outline(title: "Contents", depth: 3, indent: 1.6em)
    pagebreak(weak: true)
  }
  let lists-label = if (lof and lot) or (lof and lol) or (lot and lol) { "Lists" } else { none }
  if lof {
    current-section.update(if lists-label != none { lists-label } else { "List of Figures" })
    outline(title: "Figures", target: figure.where(kind: image))
    if not lot and not lol { pagebreak(weak: true) }
  }
  if lot {
    current-section.update(if lists-label != none { lists-label } else { "List of Tables" })
    outline(title: "Tables", target: figure.where(kind: table))
    if not lol { pagebreak(weak: true) }
  }
  if lol {
    current-section.update(if lists-label != none { lists-label } else { "List of Listings" })
    outline(title: "Listings", target: figure.where(kind: "listing"))
    pagebreak(weak: true)
  }

  // ---- body: switch to arabic numbering --------------------------------------
  set page(numbering: "1")
  counter(page).update(1)

  // Plain tables' rules use the resolved table-rule color.
  set table.hline(stroke: report-rule-width + table-rule)

  if cols > 1 { columns(cols, doc) } else { doc }

  // ---- back cover -------------------------------------------------------------
  if back-cover {
    page(
      paper: paper, margin: 0pt, header: none, footer: none, numbering: none,
      fill: gradient.linear(report-midnight, report-nav, angle: 155deg),
      {
        align(center + horizon, stack(dir: ttb, spacing: 0.35in,
          snowflake(1.5in, color.mix((report-primary-light, 70%), (report-nav, 30%)), thickness: 2pt),
          if title != none { text(size: 12pt, fill: report-primary-mist, title) },
        ))
      }
    )
  }
}

// ---- Pandoc template wiring ------------------------------------------------

$if(numbersections)$
#set heading(numbering: "1.1.1")
$endif$

$for(header-includes)$
$header-includes$

$endfor$
#show: doc => conf(
$if(title)$
  title: [$title$],
$endif$
$if(subtitle)$
  subtitle: [$subtitle$],
$endif$
$if(author)$
  authors: (
$for(author)$
$if(author.name)$
    (name: [$author.name$]),
$else$
    (name: [$author$]),
$endif$
$endfor$
  ),
$endif$
$if(date)$
  date: [$date$],
$endif$
$if(version)$
  version: [$version$],
$endif$
$if(abstract)$
  abstract: [$abstract$],
$endif$
$if(executive-summary)$
  exec-summary: [$executive-summary$],
$endif$
$if(summary)$
  summary: [$summary$],
$endif$
$if(acronyms)$
  acronyms: (
$for(acronyms)$
    (abbr: "$it.abbr$", term: "$it.term$"),
$endfor$
  ),
$endif$
$if(definitions)$
  definitions: (
$for(definitions)$
    (term: "$it.term$", definition: "$it.definition$"),
$endfor$
  ),
$endif$
$if(acknowledgments)$
  acknowledgments: [$acknowledgments$],
$endif$
  cover:          $if(no-cover)$false$else$true$endif$,
$if(cover-style)$
  cover-style: "$cover-style$",
$endif$
  back-cover:     $if(back-cover)$true$else$false$endif$,
  toc:            $if(toc)$true$else$false$endif$,
  lof:            $if(lof)$true$else$false$endif$,
  lot:            $if(lot)$true$else$false$endif$,
  lol:            $if(lol)$true$else$false$endif$,
$if(theme-color)$
  theme-color: "$theme-color$",
$endif$
$if(primary-color)$
  primary-color: "$primary-color$",
$endif$
$if(rule-color)$
  rule-color: "$rule-color$",
$endif$
$if(table-rule-color)$
  table-rule-color: "$table-rule-color$",
$endif$
$if(page-rule-color)$
  page-rule-color: "$page-rule-color$",
$endif$
$if(verbatim-color)$
  verbatim-color: "$verbatim-color$",
$endif$
$if(verbatim-accent-color)$
  verbatim-accent-color: "$verbatim-accent-color$",
$endif$
$if(verbatim-background-color)$
  verbatim-background-color: "$verbatim-background-color$",
$endif$
$if(caption-color)$
  caption-color: "$caption-color$",
$endif$
$if(linkcolor)$
  linkcolor: "$linkcolor$",
$endif$
$if(mainfont)$
  font: ("$mainfont$",),
$endif$
$if(codefont)$
  monofont: ($for(codefont)$"$codefont$",$endfor$),
$endif$
$if(fontsize)$
  fontsize: $fontsize$,
$endif$
$if(papersize)$
  paper: "$papersize$",
$endif$
  cols: $if(columns)$$columns$$else$1$endif$,
  no-indent: $if(no-indent)$true$else$false$endif$,
  doc,
)

$for(include-before)$
$include-before$

$endfor$
$body$

$if(citations)$
$for(nocite-ids)$
#cite(label("$it$"), form: none)
$endfor$
$if(csl)$
#set bibliography(style: "$csl$")
$elseif(bibliographystyle)$
#set bibliography(style: "$bibliographystyle$")
$endif$
$if(bibliography)$
#bibliography(($for(bibliography)$"$bibliography$"$sep$, $endfor$)$if(full-bibliography)$, full: true$endif$)
$endif$
$endif$

$for(include-after)$
$include-after$

$endfor$
